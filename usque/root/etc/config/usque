config usque 'main'
	option enabled '1'
	option iface 'warp0'
	option config '/etc/usque/config.json'
	option always_reconnect '1'
	option http2 '0'
	option endpoint_h2_v4 ''
	option endpoint_h2_v6 ''
	option ipv6 '0'
	option sni ''
	option port '443'
	option keepalive '30'
	option reconnect_delay '1'
	option mtu '1280'
	option insecure '0'
	option no_tunnel_ipv4 '0'
	option no_tunnel_ipv6 '0'
	option tun_metric '10'
	option wan_metric '250'
	option strict '0'
	option manage_firewall '1'
	option manage_dns '1'
	option dns '1.1.1.1'
