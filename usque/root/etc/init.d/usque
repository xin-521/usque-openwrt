#!/bin/sh
# =============================================================================
#  /etc/init.d/usque  ——  procd service for usque nativetun
#
#  Configuration precedence (first match wins):
#    1. UCI      /etc/config/usque  (section 'main', editable from LuCI)
#    2. shell    /etc/usque/options.sh (legacy overrides, still supported)
#    3. built-in defaults below
#
#  The LuCI app writes only /etc/config/usque; committing it triggers a
#  procd reload through service_triggers().  The hooks in /etc/usque/up.sh
#  and /etc/usque/down.sh receive the metrics below through the environment.
# =============================================================================

USE_PROCD=1
START=95          # after network(20)/firewall
STOP=10

PROG=/usr/bin/usque
DEFAULT_CONFIG=/etc/usque/config.json
OPTIONS=/etc/usque/options.sh
HOOK_UP=/etc/usque/up.sh
HOOK_DOWN=/etc/usque/down.sh

[ -f "$OPTIONS" ] && . "$OPTIONS"
: "${USQUE_IFACE:=warp0}"
: "${USQUE_EXTRA_ARGS:=--always-reconnect}"

# cfg <uci-option> <fallback>
cfg() {
	local v
	v=$(uci -q get "usque.main.$1" 2>/dev/null)
	if [ -n "$v" ]; then
		printf '%s' "$v"
	else
		printf '%s' "$2"
	fi
}

is_on() {
	[ "$1" = "1" ] || [ "$1" = "on" ] || [ "$1" = "true" ] || [ "$1" = "yes" ]
}

start_service() {
	[ -x "$PROG" ] || { logger -t usque "executable not found: $PROG"; return 1; }

	local enabled config iface always http2 ipv6 sni port keepalive rdelay mtu
	local insecure no4 no6 tun_metric wan_metric

	enabled=$(cfg enabled 1)
	if ! is_on "$enabled"; then
		logger -t usque "disabled by UCI (usque.main.enabled=$enabled)"
		return 0
	fi

	# quic-go wants a 7.5 MB UDP socket buffer; apply the shipped sysctl limits
	# on every start so a package upgrade does not require a reboot.
	if [ -f /etc/sysctl.d/90-usque.conf ] && command -v sysctl >/dev/null 2>&1; then
		sysctl -p /etc/sysctl.d/90-usque.conf >/dev/null 2>&1
	fi

	config=$(cfg config "$DEFAULT_CONFIG")
	[ -f "$config" ] || { logger -t usque "config not found: $config (run usque register)"; return 1; }

	iface=$(cfg iface "$USQUE_IFACE")
	always=$(cfg always_reconnect 1)
	http2=$(cfg http2 0)
	ipv6=$(cfg ipv6 0)
	sni=$(cfg sni "")
	port=$(cfg port 443)
	keepalive=$(cfg keepalive 30)
	rdelay=$(cfg reconnect_delay 1)
	mtu=$(cfg mtu 1280)
	insecure=$(cfg insecure 0)
	no4=$(cfg no_tunnel_ipv4 0)
	no6=$(cfg no_tunnel_ipv6 0)
	tun_metric=$(cfg tun_metric "${USQUE_TUN_METRIC:-10}")
	wan_metric=$(cfg wan_metric "${USQUE_WAN_METRIC:-250}")

	set -- -c "$config" nativetun \
		--interface-name "$iface" \
		--on-connect "$HOOK_UP" \
		--on-disconnect "$HOOK_DOWN"

	is_on "$always" && set -- "$@" --always-reconnect
	is_on "$http2" && set -- "$@" --http2
	is_on "$ipv6" && set -- "$@" -6
	is_on "$insecure" && set -- "$@" --insecure
	[ -n "$sni" ] && set -- "$@" -s "$sni"
	[ -n "$port" ] && [ "$port" != "443" ] && set -- "$@" -P "$port"
	[ -n "$keepalive" ] && [ "$keepalive" != "30" ] && set -- "$@" --keepalive-period "${keepalive}s"
	[ -n "$rdelay" ] && [ "$rdelay" != "1" ] && set -- "$@" --reconnect-delay "${rdelay}s"
	[ -n "$mtu" ] && [ "$mtu" != "1280" ] && set -- "$@" --mtu "$mtu"
	is_on "$no4" && set -- "$@" --no-tunnel-ipv4
	is_on "$no6" && set -- "$@" --no-tunnel-ipv6

	# Legacy bridge: append custom options from /etc/usque/options.sh unless it
	# still holds the shipped default.  Word splitting is intentional here.
	if [ -n "$USQUE_EXTRA_ARGS" ] && [ "$USQUE_EXTRA_ARGS" != "--always-reconnect" ]; then
		set -- "$@" $USQUE_EXTRA_ARGS
	fi

	procd_open_instance usque
	procd_set_param command "$PROG" "$@"
	procd_set_param env \
		USQUE_IFACE="$iface" \
		USQUE_TUN_METRIC="$tun_metric" \
		USQUE_WAN_METRIC="$wan_metric"
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config"
	procd_close_instance
}

stop_service() {
	logger -t usque "stopping usque (WAN fallback route will take over)"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger usque
}
